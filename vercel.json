{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/dispatch.mjs": { "includeFiles": "src/schema.sql" }
  },
  "rewrites": [
    { "source": "/api/:path(.*)", "destination": "/api/dispatch?__frontdesk_path=:path" }
  ],
  "crons": [
    { "path": "/api/cron/auto-close", "schedule": "0 14 * * *" }
  ]
}
