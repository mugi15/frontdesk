{
  "name": "frontdesk-support-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small support desk demo with working-hours SLAs and an auditable ticket lifecycle.",
  "scripts": {
    "start": "node --env-file=.env src/server.mjs",
    "dev": "node --env-file=.env --watch src/server.mjs",
