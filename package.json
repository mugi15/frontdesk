    "test:unit": "node --test test/business-clock.test.mjs",
    "test:integration": "node --env-file=.env --test test/frontdesk.test.mjs"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jsdom": "26.1.0"
  }
}
